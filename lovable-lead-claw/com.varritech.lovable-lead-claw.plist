<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.varritech.lovable-lead-claw</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__CLAW_DIR__/bin/run-daily.sh</string>
		<string>--no-report</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/lovable-lead-claw.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/lovable-lead-claw.out</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
