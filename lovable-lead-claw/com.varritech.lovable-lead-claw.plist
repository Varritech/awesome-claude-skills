<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.varritech.lovable-lead-claw</string>
  <!-- Daily 07:00 local. Volume is capped in code (GITHUB_REPOS_PER_DAY, APIFY_DAILY_USD). -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__CLAW_DIR__/bin/run-daily.sh</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>/tmp/lovable-lead-claw.err</string>
  <key>StandardOutPath</key><string>/tmp/lovable-lead-claw.out</string>
</dict>
</plist>
