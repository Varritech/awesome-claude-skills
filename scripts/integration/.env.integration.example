# Copy to .env.integration.local (gitignored) and fill in.

INTEGRATION_BASE_URL=https://convergeflow-push.vercel.app
INTEGRATION_CLERK_TOKEN=eyJ...
INTEGRATION_USER_ID=user_...
INTEGRATION_TO_EMAIL=your.gmail+convergeflow-int@gmail.com

FIREBASE_ADMIN_PROJECT_ID=convergeflow-69942
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@convergeflow-69942.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Optional — only set these if you want to test against a real SMTP server
# (Gmail app password, Mailgun, your own server). If unset, an Ethereal Email
# throwaway account is created automatically.
# INTEGRATION_SMTP_HOST=smtp.gmail.com
# INTEGRATION_SMTP_PORT=587
# INTEGRATION_SMTP_USER=you@gmail.com
# INTEGRATION_SMTP_PASSWORD=app-password-here
