{
  "name": "convergeflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:coverage": "vitest run --config vitest.config.mjs --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sonar": "sonar-scanner",
    "quality": "npm run lint && npm run format:check && npm run test && npm run test:e2e",
    "audit:security": "npm audit --audit-level=high",
    "prepare": "cd .. && husky convergeflow/.husky"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.6",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.49.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "imapflow": "^1.4.8",
    "inngest": "^4.4.0",
    "next": "14.2.35",
    "nodemailer": "^6.9.15",
    "ollama": "^0.6.3",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "stripe": "^22.0.2",
    "svix": "^1.90.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
    "prettier": "^3.8.2",
    "sonarqube-scanner": "^4.3.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^6.4.2",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
