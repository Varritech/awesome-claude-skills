# ── Offer (Skills Library — the fixed daily subject) ──
OFFER_NAME=Claude Code Skills Library
OFFER_PITCH=70+ production Claude Code skills that turn one prompt into shipped work — ads, apps, audits, outreach.
OFFER_URL=https://www.varritech.com/products/claude-skills-library-pro
OFFER_GOAL=purchase
OFFER_CTA=SHOP_NOW
OFFER_LINK_MATCH=claude-skills-library
BRAND_ACCENT=#99FF32
BRAND_INDIGO_DEEP=#190336
BRAND_ELECTRIC=#8638EE

# ── Daily mix ──
DAILY_VIDEO_COUNT=2
DAILY_STATIC_COUNT=2
MINING_NICHE=claude-code-skills

# ── Meta (act + test campaign the 4 ads join daily; new adset/day) ──
META_AD_ACCOUNT_ID=act_1058527832767816
META_PIXEL_ID=1575933943079817
META_PAGE_ID=
META_TEST_CAMPAIGN_ID=
DAILY_BUDGET_CAP_USD=50

# ── Composio (Meta create/upload/act) ──
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default

# ── Approval: gate (email preview, you click launch) | auto ──
AUTONOMY=gate
PUBLIC_BASE_URL=https://adfactory-xxxx.run.app
APPROVE_SECRET=change-me-long-random

# ── GCS asset library ──
GCS_BUCKET=varritech-public-assets
GCS_PREFIX=videos/adfactory

# ── Veo3 (Vertex) — offline OAuth so Cloud Run can mint user-scoped tokens ──
# generate GOOGLE_OAUTH_REFRESH_TOKEN once locally: npm run mint-veo-token
VEO_PROJECT=varribrain
VEO_LOCATION=us-central1
VEO_MODEL=veo-3.0-generate-001
VEO_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── ElevenLabs (Liam VO) ──
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ

# ── Claude ──
ANTHROPIC_API_KEY=
CLAW_MODEL=claude-opus-4-8

# ── Email (gated preview + reports) ──
OWNER_EMAIL=christian@varritech.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AdFactory Claw <ads@varritech.com>

# ── Source swipe pool (optional; mounted dir of viral .mp4s to frame-match) ──
SWIPE_DIR=/app/swipe

# ── Variant loop (daily autopilot) ──
META_CONNECTED_ACCOUNT_ID=
VARIANTS_MAX_NEW_PER_ADSET=1
VARIANTS_MAX_LIVE_PER_ADSET=4
VARIANTS_RETIRE_SPEND_USD=60
CHROMIUM_BIN=/usr/bin/chromium

# ── PostHog (the variant loop's conversion signal) ──
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=489511
