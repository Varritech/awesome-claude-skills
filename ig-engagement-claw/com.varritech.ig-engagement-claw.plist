<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.varritech.ig-engagement-claw</string>

  <!-- Every 5 minutes: catch a follow/like while the person still remembers us.
       ⛔ Polling this often does NOT mean sending this often. The send budget is
       wall-clock (MAX_PER_HOUR / MAX_PER_DAY, enforced in select.js against the
       ledger), so most runs correctly do nothing. launchd does not wake the Mac,
       and the run aborts unless Dia is open, logged in, and the Browser MCP
       extension is Connected. -->
  <key>StartInterval</key><integer>300</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Start conservative. Raise only after watching a week of real runs. -->
    <!-- ⛔ KILL_SWITCH was ABSENT here for days while it was set on the INSTALLED
         job, so grepping this file reported "off" when the live job was killed.
         Always read the truth with `launchctl print gui/$(id -u)/<label>`.
         0 = live. Turned on 2026-08-17 after the first two real DMs were sent
         and verified by hand. Set to 1 to make every run inert. -->
    <key>KILL_SWITCH</key><string>0</string>
    <key>RUN_CAP</key><string>2</string>
    <key>MAX_PER_HOUR</key><string>4</string>
    <key>MAX_PER_DAY</key><string>0</string>
    <key>CLAW_TZ</key><string>America/New_York</string>
    <key>START_HOUR</key><string>0</string>
    <key>END_HOUR</key><string>24</string>
  </dict>

  <!-- ⛔ --model is PINNED here on purpose. `claude -p` otherwise inherits
       ~/.claude/settings.json's global "model", which is the llm-router's
       Ollama lane (glm-5.3-flash:cloud). Claude Code does not know that id and
       hard-fails the run with "There's an issue with the selected model" —
       596 such lines accumulated in state/run.log, i.e. that many dead runs.
       The claw must not be hostage to whatever lane the router is pointed at. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/awesome-claude-skills/ig-engagement-claw" &amp;&amp; unset ANTHROPIC_API_KEY &amp;&amp; export CLAUDE_CODE_OAUTH_TOKEN="$(cat "$HOME/.varritech/claude-oauth-token")" &amp;&amp; "$HOME/.local/bin/claude" -p "Execute an ig-engagement-claw run NOW, following the runbook below as instructions to carry out, not as a document to summarise. Start at the preflight step and finish with the one-line report.

=== RUNBOOK ===

$(cat runner-prompt.md)" --model claude-sonnet-5-5 --allowedTools "mcp__browsermcp__browser_tab,mcp__browsermcp__browser_navigate,mcp__browsermcp__browser_snapshot,mcp__browsermcp__browser_click,mcp__browsermcp__browser_type,mcp__browsermcp__browser_press_key,mcp__browsermcp__browser_scroll,mcp__browsermcp__browser_execute_js,Bash(node src/cli.js:*)" &gt;&gt; state/run.log 2&gt;&amp;1</string>
  </array>

  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>/tmp/ig-engagement-claw.err</string>
</dict>
</plist>
