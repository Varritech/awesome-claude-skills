<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.varritech.ig-value-news</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>$HOME/awesome-claude-skills/ig-engagement-claw/bin/news-refresh.sh</string>
  </array>
  <!-- Daily at 07:30 local; the script exits at once if today's news is already stored. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/ig-value-news.out</string>
  <key>StandardErrorPath</key><string>/tmp/ig-value-news.err</string>
</dict>
</plist>
